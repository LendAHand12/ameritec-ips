NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
APP_NAME=Ameritec IPS

MONGODB_URI=mongodb://127.0.0.1:27017/ameritec_ips

# Auth — đặt chuỗi ngẫu nhiên dài: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Phiên admin ngắn hơn phiên user
ADMIN_JWT_EXPIRES_IN=8h

# SMTP (ví dụ Gmail: dùng App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# Phải trùng (hoặc được phép gửi thay) SMTP_USER, nếu không mail sẽ bị từ chối / vào spam
MAIL_FROM="Ameritec IPS <no-reply@your-domain.com>"

# Upload công khai (avatar, ...) — phục vụ tại /uploads
UPLOAD_DIR=uploads
UPLOAD_MAX_SIZE_MB=10

# Ảnh giấy tờ tuỳ thân — riêng tư, KHÔNG public
KYC_DIR=storage/kyc
KYC_MAX_SIZE_MB=10

# Tài khoản admin (bảng admins riêng) — tạo/đặt lại mật khẩu bằng: npm run seed:admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Thanh toán USDT BEP20 (BNB Smart Chain) — server tự kiểm tra giao dịch on-chain
BSC_RPC_URL=https://bsc-dataseed.binance.org
BSC_USDT_CONTRACT=0x55d398326f99059fF775485246999027B3197955
BSC_MIN_CONFIRMATIONS=5

# File riêng tư: certificate cổ phần, QR Zelle
CERTIFICATE_DIR=storage/certificates
SETTINGS_FILE_DIR=storage/settings
